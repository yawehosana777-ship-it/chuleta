# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a GitHub.

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (sb_publishable_...). Es segura en el navegador porque RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave SECRETA (sb_secret_...). Solo para el servidor y los scripts. Jamás en el navegador.
SUPABASE_SECRET_KEY=

# Dirección de la aplicación (se usa en los enlaces de invitación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
