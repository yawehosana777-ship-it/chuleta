    "db:aplicar": "supabase db push",
    "restaurante:crear": "node --env-file=.env.local --import tsx scripts/crear-restaurante.mts",
    "restaurante:invitar": "node --env-file=.env.local --import tsx scripts/invitar.mts",
    "restaurante:estado": "node --env-file=.env.local --import tsx scripts/estado-restaurante.mts",
    "carta:sql": "tsx scripts/generar-sql-carta.mts",
    "carta:cargar": "node --env-file=.env.local --import tsx scripts/cargar-carta.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@netlify/plugin-nextjs": "5.16.6",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
