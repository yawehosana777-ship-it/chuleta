{
  "name": "plataforma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "test:telefono": "playwright test",
    "claves:configurar": "node scripts/configurar-claves.mjs",
